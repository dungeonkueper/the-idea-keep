<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description || 'A public lab book for ideas, experiments, learnings, and things built below the surface.' }}">
    <meta name="theme-color" content="#171714">
    <title>{{ if title }}{{ title }} · {{ /if }}The Idea Keep</title>
    {{ if canonicalUrl }}<link rel="canonical" href="{{ canonicalUrl }}">{{ /if }}
    {{ if markdownUrl }}<link rel="alternate" type="text/markdown" href="{{ markdownUrl }}" title="Markdown">{{ /if }}
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="The Idea Keep, home">
          <span class="wordmark-mark" aria-hidden="true">◆</span>
          <span>The Idea Keep</span>
        </a>
        <span class="site-kicker">by dungeonkueper</span>
      </header>

      <main id="main-content">
        {{ content }}
      </main>

      <footer class="site-footer">
        <p>Ideas, experiments and things built below the surface.</p>
        <a href="https://github.com/dungeonkueper/the-idea-keep">View the source</a>
        {{ if cloudflareAnalyticsToken }}
        <button type="button" id="analytics-settings" hidden>Analytics preferences</button>
        {{ /if }}
        <a href="/llms.txt">Map for agents</a>
      </footer>
    </div>

    {{ if cloudflareAnalyticsToken }}
    <section id="analytics-consent" class="analytics-consent" aria-labelledby="analytics-heading" hidden>
      <h2 id="analytics-heading" tabindex="-1">May we count your visit?</h2>
      <p>With your permission, Cloudflare Web Analytics measures page visits, referrers, browser information and loading performance. Your browser connects to Cloudflare to load its script and send measurements. Cloudflare says this service uses no analytics cookies or fingerprinting.</p>
      <p>Analytics is optional. You can use the entire Keep without it, and withdraw permission through “Analytics preferences” below. We store your choice in this browser for 180 days. If storage is unavailable, your choice applies only to this page.</p>
      <p><a href="https://www.cloudflare.com/privacypolicy/" rel="noreferrer">Cloudflare privacy policy</a></p>
      <p id="analytics-status" role="status"></p>
      <div class="analytics-actions">
        <button type="button" id="analytics-reject">Do not allow analytics</button>
        <button type="button" id="analytics-accept">Allow analytics</button>
        <button type="button" id="analytics-close" hidden>Close preferences</button>
      </div>
    </section>
    <script defer src="/analytics-consent.js" data-analytics-token="{{ cloudflareAnalyticsToken }}"></script>
    {{ /if }}
  </body>
</html>
