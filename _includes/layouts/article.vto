---
layout: layouts/base.vto
---
<article class="article">
  <a class="back-link" href="/">← Back to the Keep</a>

  <header class="article-header">
    <div class="metadata" aria-label="Content metadata">
      <span class="badge badge-kind">{{ kindLabel }}</span>
      <span class="badge">{{ maturityLabel }}</span>
      <time datetime="{{ displayDate }}">{{ displayDate }}</time>
    </div>
    <h1>{{ title }}</h1>
    <p class="article-summary">{{ summary }}</p>
    <a href="{{ markdownUrl }}">Read as Markdown</a>
  </header>

  {{ if optionalSupport }}
  <aside aria-label="Optional testnet support">
    <p>Support is optional. This Egg is free to read. The support experiment uses only Tempo Testnet tokens.</p>
    <script type="application/json" id="optional-support">{{ supportJson }}</script>
  </aside>
  {{ /if }}

  <div class="prose">
    {{ content }}
  </div>
</article>
