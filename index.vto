---
layout: layouts/base.vto
title: Home
description: The Idea Keep is a public lab book for ideas, experiments, learnings, projects, and useful artifacts.
url: /
---
<section class="hero">
  <p class="eyebrow">A public lab book</p>
  <h1>Ideas worth keeping.<br><span>Experiments worth attempting.</span></h1>
  <p class="hero-copy">
    The Idea Keep is a home for work in progress: thoughts can begin as seeds,
    experiments can fail in public, and useful learnings can emerge over time.
  </p>
  <p class="principle"><span aria-hidden="true">✦</span> Unfinished is publishable.</p>
</section>

<div class="threshold" aria-hidden="true"></div>

{{# The Hatchery stays visible even when empty; the other wings appear with their first entry. #}}
{{ include "wing.vto" {
  id: "hatchery",
  label: "Wing A — The Hatchery",
  heading: "From the Hatchery",
  description: "Early thoughts, hypotheses, and the beginnings of things.",
  items: search.pages("publicationStatus=published kind=idea", "chamber=desc"),
  readLabel: "Enter the chamber",
} }}

{{ set experiments = search.pages("publicationStatus=published kind=experiment", "chamber=desc") }}
{{ if experiments.length }}
{{ include "wing.vto" {
  id: "laboratory",
  label: "Wing B — The Laboratory",
  heading: "From the Laboratory",
  description: "Hypotheses put to the test, with their setup, findings, and limits.",
  items: experiments,
  readLabel: "Enter the chamber",
} }}
{{ /if }}

{{ set tidings = search.pages("wing=tidings publicationStatus=published", "updated=desc") }}
{{ if tidings.length }}
{{ include "wing.vto" {
  id: "tidings",
  label: "Outer Wing — Tidings",
  heading: "Tidings from the Surface",
  description: "Events from beyond the Keep: what is known, and a view from below.",
  items: tidings,
  cardClass: "tiding-card",
  readLabel: "Read the tiding",
} }}
{{ /if }}
