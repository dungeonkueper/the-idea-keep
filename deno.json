{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/"
  },
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P3D",
  "tasks": {
    "bootstrap": "deno ci && deno check --frozen-lockfile lume.ts _config.ts content_model.ts",
    "build": "deno run --cached-only --frozen-lockfile --no-prompt -P=build lume.ts",
    "serve": "deno run --cached-only --frozen-lockfile --no-prompt -P=serve lume.ts -s",
    "audit": "deno audit --level=high --frozen-lockfile",
    "test": "deno test --cached-only --frozen-lockfile",
    "check": "deno fmt --check _config.ts content_model.ts content_model_test.ts lume.ts deno.json SECURITY.md .github && deno lint _config.ts content_model.ts content_model_test.ts lume.ts && deno check --cached-only --frozen-lockfile lume.ts _config.ts content_model.ts content_model_test.ts && deno task test && deno task build"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "permissions": {
    "build": {
      "env": {
        "allow": [
          "CLOUDFLARE_WEB_ANALYTICS_TOKEN"
        ],
        "ignore": [
          "DENO_AUTH_TOKENS",
          "DENO_DEPLOYMENT_ID",
          "LUME_CONCURRENCY",
          "LUME_DRAFTS",
          "LUME_LIVE_RELOAD",
          "LUME_LOGS",
          "LUME_NOCACHE"
        ]
      },
      "ffi": false,
      "import": false,
      "net": false,
      "read": [
        "."
      ],
      "run": false,
      "sys": false,
      "write": [
        "./_site"
      ]
    },
    "serve": {
      "env": {
        "allow": [
          "CLOUDFLARE_WEB_ANALYTICS_TOKEN",
          "DENO_DIR"
        ],
        "ignore": [
          "DENO_AUTH_TOKENS",
          "DENO_DEPLOYMENT_ID",
          "LUME_CONCURRENCY",
          "LUME_DRAFTS",
          "LUME_LIVE_RELOAD",
          "LUME_LOGS",
          "LUME_NOCACHE"
        ]
      },
      "ffi": false,
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443"
      ],
      "net": [
        "0.0.0.0",
        "127.0.0.1",
        "localhost"
      ],
      "read": [
        "."
      ],
      "run": false,
      "sys": false,
      "write": [
        "./_site"
      ]
    }
  }
}
